# 反馈渠道配置模板 —— 复制成 secrets.toml(本地)或填进 Streamlit Cloud 后台的 Secrets。
# 真实 secrets.toml 已 gitignore,密钥绝不进公开仓库。
#
# 云端:app 后台 → Settings → Secrets,把下面这段粘进去(不含本注释)。
# 本地:cp .streamlit/secrets.toml.example .streamlit/secrets.toml 再填。

[feedback]
# —— 方式一:邮件(推荐)。去 resend.com 注册免费账号拿 API key。
# 测试模式用 onboarding@resend.dev 发信,只能发给你的注册邮箱本人 —— 零域名验证。
resend_api_key = "re_xxxxxxxxxxxxxxxxxxxx"
email = "huanghzevan@gmail.com"
# from = "onboarding@resend.dev"   # 选填,默认即此;验证了自己域名后可改成 monitor@你的域名

# —— 方式二(可选):通用 webhook,填了则优先于邮件。Slack/飞书/Discord/Google Apps Script 均可。
# webhook_url = "https://hooks.slack.com/services/..."
